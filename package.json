{
  "name": "fiiofixer",
  "private": true,
  "version": "0.7.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "node scripts/licenses.mjs && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "test:bridge": ".venv/bin/python -m unittest discover -s bridge -p 'test_*.py' -v",
    "doctor": "node scripts/doctor.mjs",
    "linux": "bash scripts/start-linux.sh",
    "package:linux": "npm run build && python3 scripts/package-linux.py",
    "install:linux": "bash scripts/install-linux.sh",
    "update:linux": "bash scripts/update-linux.sh"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/cinzel-decorative": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-bluetooth": "^0.0.22",
    "@vitejs/plugin-react": "^6.1.2",
    "del": "^5.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "description": "FiiO EH11 EQ editor with portable presets and Squig.link import/export.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  }
}
